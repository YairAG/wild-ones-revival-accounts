# Copia este archivo como .env y ajusta los valores. El .env no se sube a git.

# Puerto HTTP de este backend
PORT=3000

# La misma base que el servidor de juego
MONGO_URL=mongodb://localhost:27017/emu

# El mismo secreto que el servidor de juego (JWT_SECRET de su .env). Obligatorio
JWT_SECRET=cambia-esto

# Duración del token de acceso (JWT). Corto: el frontend lo renueva solo con el refresh token
JWT_EXPIRES_IN=15m

# Días que dura la sesión (refresh token en una cookie httpOnly). Cada renovación vuelve a contar desde cero
REFRESH_TOKEN_DAYS=30

# true en producción (HTTPS): la cookie de sesión solo viaja cifrada
COOKIE_SECURE=false

# URL del frontend (para CORS). Tiene que ser exacta (no "*"): el navegador manda la cookie de sesión.
# En producción, frontend y este backend en el mismo sitio (p. ej. juego.ejemplo.com y cuentas.ejemplo.com)
CORS_ORIGIN=http://localhost:5173

# Intentos de registro/login por minuto y por IP
REQUESTS_PER_MINUTE=10

# Detalle de los logs: debug, info, warn o error
LOG_LEVEL=info
